{
  "name": "whereheplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "WhereHePlay — a daily 'where did he play in college?' trivia game for NFL and NBA players.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch-raw": "node scripts/fetch-raw.mjs",
    "build-players": "node scripts/build-players.mjs",
    "scan-headshots": "node scripts/scan-headshots.mjs",
    "fetch-photo-meta": "node scripts/fetch-photo-meta.mjs",
    "audit-photos": "node scripts/audit-photos.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:migrate": "wrangler d1 migrations apply whp-api --remote -c worker/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply whp-api --local -c worker/wrangler.toml"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
