# Copy to .env.local for local development. Everything here is PUBLIC client
# config (it ships in the JS bundle) — never put a secret in a VITE_ variable.

# URL of the whp-api worker. Unset → the leaderboard and accounts are hidden
# and the game is fully playable offline-style.
#   local worker:  npm run worker:migrate:local && npm run worker:dev
# VITE_API_ENDPOINT=http://localhost:8787

# Optional Cloudflare Web Analytics token (cookieless page views).
# VITE_CF_BEACON_TOKEN=
